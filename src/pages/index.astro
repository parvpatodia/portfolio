---
import V2Layout from '../layouts/V2Layout.astro';
---

<V2Layout title="Parv Patodia | AI/ML & Robotics Engineer">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-main">
        <p class="eyebrow hero-eyebrow"><span class="accent">//</span> perception &middot; policy &middot; the real world</p>
        <div class="name-stage">
          <h1 class="sr-only">Parv Patodia</h1>
          <div class="hero-name-fallback" aria-hidden="true">Parv<br /><span class="muted">Patodia</span></div>
          <canvas id="name-canvas" class="name-canvas" aria-hidden="true"></canvas>
          <p class="diffusion-readout" aria-hidden="true">
            <span class="t" id="diff-t">denoising &middot; t=1000</span>
            <button class="resample-btn" id="resample" type="button">&#8635; resample</button>
          </p>
        </div>
        <p class="hero-lede">I build ML systems that <strong>perceive, decide, and behave reliably</strong> in the real world. Right now: closed-loop driving-policy research at Northeastern.</p>
        <div class="cta-row">
          <a href="/work" class="btn btn-primary">Explore work</a>
          <a href="/resume.pdf" class="btn btn-ghost" target="_blank" rel="noopener noreferrer">Résumé</a>
          <a href="https://github.com/parvpatodia" class="btn btn-ghost btn-icon" target="_blank" rel="noopener noreferrer" aria-label="GitHub profile, opens in new tab">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/parvpatodia-ai-silicon-valley" class="btn btn-ghost btn-icon" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn profile, opens in new tab">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.44-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
          </a>
        </div>
      </div>
      <div class="hud" aria-label="status panel">
        <div class="hud-row"><span class="hud-k">status</span><span class="hud-v on">open // fall 2026 co-op</span></div>
        <div class="hud-row"><span class="hud-k">location</span><span class="hud-v">San Jose, CA</span></div>
        <div class="hud-row"><span class="hud-k">focus</span><span class="hud-v amber">closed-loop driving policy</span></div>
        <div class="hud-row"><span class="hud-k">domain</span><span class="hud-v">perception / planning / ML</span></div>
        <div class="hud-row"><span class="hud-k">edu</span><span class="hud-v">MS AI, Northeastern '27</span></div>
      </div>
    </div>
  </section>

  <section class="wrap" style="padding: 5rem 1.75rem 7rem;">
    <p class="eyebrow reveal" style="margin-bottom: 1.5rem;">directory</p>
    <ul class="index-list reveal">
      <li><a href="/work"><span class="index-num">01</span><span class="index-title">Work</span><span class="index-desc">Research, projects, and shipped systems.</span></a></li>
      <li><a href="/story"><span class="index-num">02</span><span class="index-title">Story</span><span class="index-desc">India to Singapore to Silicon Valley.</span></a></li>
      <li><a href="/beyond"><span class="index-num">03</span><span class="index-title">Beyond</span><span class="index-desc">Sport, books, and the rest of me.</span></a></li>
      <li><a href="/contact"><span class="index-num">04</span><span class="index-title">Contact</span><span class="index-desc">Best reached by email.</span></a></li>
    </ul>
  </section>

  <script>
    // ── Signature: the name denoises out of pixel noise (diffusion motif). ──────
    const stage = document.getElementById('name-canvas') as HTMLCanvasElement | null;
    const heroEl = document.querySelector('.hero') as HTMLElement | null;
    const tEl = document.getElementById('diff-t');
    const resampleBtn = document.getElementById('resample');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (stage && heroEl && !reduce) {
      const ctx = stage.getContext('2d')!;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      let w = 0, h = 0, raf = 0;
      type P = { tx: number; ty: number; x: number; y: number; vx: number; vy: number; teal: boolean };
      let parts: P[] = [];
      const mouse = { x: -9999, y: -9999 };

      function buildTargets() {
        const rect = stage!.getBoundingClientRect();
        w = rect.width; h = rect.height;
        if (w < 2 || h < 2) return;
        stage!.width = Math.floor(w * dpr); stage!.height = Math.floor(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const off = document.createElement('canvas');
        off.width = Math.floor(w); off.height = Math.floor(h);
        const octx = off.getContext('2d')!;
        octx.fillStyle = '#fff';
        octx.textAlign = 'left';
        octx.textBaseline = 'top';
        const lines = ['Parv', 'Patodia'];
        let fontSize = Math.min(h * 0.47, w * 0.34);
        const setFont = () => { octx.font = `700 ${fontSize}px "Bricolage Grotesque", "Space Grotesk", sans-serif`; };
        setFont();
        const widest = Math.max(...lines.map((l) => octx.measureText(l).width));
        if (widest > w * 0.98) { fontSize *= (w * 0.98) / widest; setFont(); }
        const lineH = fontSize * 0.98;
        const y0 = (h - lineH * lines.length) / 2;
        lines.forEach((l, i) => octx.fillText(l, 1, y0 + i * lineH));

        const img = octx.getImageData(0, 0, off.width, off.height).data;
        const gap = w < 520 ? 4 : 5;
        const targets: { x: number; y: number }[] = [];
        for (let y = 0; y < off.height; y += gap)
          for (let x = 0; x < off.width; x += gap)
            if (img[(y * off.width + x) * 4 + 3] > 128) targets.push({ x, y });

        parts = targets.map((t, i) => ({ tx: t.x, ty: t.y, x: Math.random() * w, y: Math.random() * h, vx: 0, vy: 0, teal: i % 12 === 0 }));
      }

      let running = false, jitter = 0, visible = true;

      function renoise() {
        for (const p of parts) { p.x = Math.random() * w; p.y = Math.random() * h; p.vx = 0; p.vy = 0; }
        jitter = 7; kick();
      }

      // Reverse-diffusion-style: spring toward the glyph target while a global
      // noise term (jitter) decays each frame. The shrinking jitter is the schedule.
      function loop() {
        if (!visible) { running = false; return; }
        ctx.clearRect(0, 0, w, h);
        const k = 0.03, damp = 0.84, R = 72;
        let totalD = 0, totalV = 0;
        for (const p of parts) {
          p.vx += (p.tx - p.x) * k;
          p.vy += (p.ty - p.y) * k;
          const dx = p.x - mouse.x, dy = p.y - mouse.y, d2 = dx * dx + dy * dy;
          if (d2 < R * R) { const d = Math.sqrt(d2) || 1; const f = (1 - d / R) * 4.5; p.vx += (dx / d) * f; p.vy += (dy / d) * f; }
          p.vx *= damp; p.vy *= damp;
          p.x += p.vx + (Math.random() - 0.5) * jitter;
          p.y += p.vy + (Math.random() - 0.5) * jitter;
          totalV += Math.abs(p.vx) + Math.abs(p.vy);
          const dist = Math.abs(p.tx - p.x) + Math.abs(p.ty - p.y);
          totalD += dist;
          ctx.fillStyle = (p.teal ? 'rgba(52,214,192,' : 'rgba(242,179,61,') + (dist < 1.6 ? 0.92 : 0.5) + ')';
          ctx.fillRect(p.x, p.y, 1.7, 1.7);
        }
        jitter *= 0.95;
        if (tEl) {
          const t = Math.round(Math.max(0, Math.min(1, (totalD / parts.length) / 55)) * 1000);
          tEl.textContent = t > 4 ? `denoising · t=${String(t).padStart(4, '0')}` : 'sampled · t=0000';
        }
        const idle = mouse.x < -9000;
        if (idle && jitter < 0.15 && totalV / parts.length < 0.04) { running = false; return; }
        raf = requestAnimationFrame(loop);
      }

      function kick() { if (!running && parts.length && visible) { running = true; raf = requestAnimationFrame(loop); } }

      function init() {
        cancelAnimationFrame(raf); running = false;
        buildTargets();
        if (parts.length) { heroEl!.classList.add('canvas-on'); jitter = 7; kick(); }
      }

      const fonts = (document as any).fonts;
      if (fonts && fonts.ready) fonts.ready.then(init); else init();

      new IntersectionObserver((es) => { visible = es[0].isIntersecting; if (visible) kick(); }, { threshold: 0 }).observe(heroEl);

      let rz = 0;
      window.addEventListener('resize', () => { clearTimeout(rz); rz = window.setTimeout(init, 200); }, { passive: true });
      stage.addEventListener('mousemove', (e) => { const r = stage.getBoundingClientRect(); mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top; kick(); }, { passive: true });
      stage.addEventListener('mouseleave', () => { mouse.x = -9999; mouse.y = -9999; });
      resampleBtn?.addEventListener('click', renoise);
    }

    // ── Reveal on scroll ────────────────────────────────────────────────────────
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</V2Layout>
