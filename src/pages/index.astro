---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Scroll progress -->
  <div id="scroll-progress" aria-hidden="true"></div>

  <!-- Precision cursor -->
  <div class="cursor-ring" aria-hidden="true"></div>
  <div class="cursor-dot-inner" aria-hidden="true"></div>

  <!-- NAV -->
  <nav id="navbar" aria-label="Main navigation">
    <div class="nav-inner">
      <a href="#hero" class="nav-logo">Parv Patodia</a>
      <span class="nav-breadcrumb" id="nav-breadcrumb" aria-hidden="true"></span>
      <ul class="nav-links">
        <li><a href="#about">About</a></li>
        <li><a href="#experience">Experience</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#research">Research</a></li>
        <li><a href="#hackathons">Hackathons</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
      <div class="open-to-work" aria-label="Open to work status">
        <span class="dot" aria-hidden="true"></span>
        Open to Work
      </div>
      <button class="hamburger" id="hamburger" aria-label="Toggle navigation menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <div class="mobile-menu" id="mobile-menu" role="menu">
      <a href="#about" role="menuitem">About</a>
      <a href="#experience" role="menuitem">Experience</a>
      <a href="#projects" role="menuitem">Projects</a>
      <a href="#research" role="menuitem">Research</a>
      <a href="#hackathons" role="menuitem">Hackathons</a>
      <a href="#skills" role="menuitem">Skills</a>
      <a href="#contact" role="menuitem">Contact</a>
    </div>
  </nav>

  <!-- Boot sequence overlay -->
  <div id="boot-overlay" aria-hidden="true">
    <div id="boot-scanline"></div>
    <div id="boot-text">
      <span id="boot-name"></span><span class="boot-cursor">&#9608;</span>
    </div>
  </div>

  <main>
    <!-- HERO -->
    <section id="hero" aria-label="Introduction">
      <!-- LiDAR sweep SVG decoration -->
      <div class="lidar-wrap" aria-hidden="true">
        <svg class="lidar-svg" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
          <!-- Concentric arc rings -->
          <circle cx="200" cy="200" r="40"  fill="none" stroke="var(--accent-cyan)" stroke-width="0.8" opacity="0.6"/>
          <circle cx="200" cy="200" r="80"  fill="none" stroke="var(--accent-cyan)" stroke-width="0.8" opacity="0.6"/>
          <circle cx="200" cy="200" r="120" fill="none" stroke="var(--accent-cyan)" stroke-width="0.8" opacity="0.5"/>
          <circle cx="200" cy="200" r="160" fill="none" stroke="var(--accent-cyan)" stroke-width="0.8" opacity="0.5"/>
          <circle cx="200" cy="200" r="196" fill="none" stroke="var(--accent-cyan)" stroke-width="0.8" opacity="0.4"/>
          <!-- Cross-hair lines -->
          <line x1="200" y1="4"   x2="200" y2="396" stroke="var(--accent-cyan)" stroke-width="0.5" opacity="0.35"/>
          <line x1="4"   y1="200" x2="396" y2="200" stroke="var(--accent-cyan)" stroke-width="0.5" opacity="0.35"/>
          <line x1="60"  y1="60"  x2="340" y2="340" stroke="var(--accent-cyan)" stroke-width="0.4" opacity="0.25"/>
          <line x1="340" y1="60"  x2="60"  y2="340" stroke="var(--accent-cyan)" stroke-width="0.4" opacity="0.25"/>
          <!-- Rotating sweep line group -->
          <g class="lidar-sweep">
            <line x1="200" y1="200" x2="200" y2="10" stroke="var(--accent-cyan)" stroke-width="1.5" opacity="0.9" stroke-linecap="round"/>
            <!-- Sweep fade arc -->
            <path d="M200,10 A190,190 0 0,1 379,234" fill="none" stroke="url(#sweepGrad)" stroke-width="40" opacity="0.3"/>
          </g>
          <!-- Center dot -->
          <circle cx="200" cy="200" r="4" fill="var(--accent-cyan)" opacity="0.8"/>
          <defs>
            <linearGradient id="sweepGrad" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%"   stop-color="var(--accent-cyan)" stop-opacity="0.5"/>
              <stop offset="100%" stop-color="var(--accent-cyan)" stop-opacity="0"/>
            </linearGradient>
          </defs>
        </svg>
      </div>

      <div class="hero-content">
        <p class="hero-overline" aria-label="Current status">
          <span class="terminal-prompt" aria-hidden="true">&gt;</span>
          currently_building: av-policy-lab&nbsp;&nbsp;|&nbsp;&nbsp;San Jose, CA&nbsp;&nbsp;|&nbsp;&nbsp;open_to: Fall 2026 co-op
        </p>
        <h1 class="hero-name">Parv <span class="hero-name-light">Patodia</span></h1>
        <p class="hero-subtitle">MS AI @ Northeastern &middot; Silicon Valley</p>
        <p class="hero-tagline">I build ML systems that perceive, decide, and behave reliably in the real world.</p>
        <div class="hero-typewriter-wrap" aria-live="polite" aria-label="Current focus areas">
          <span id="typewriter-text"></span><span class="cursor" aria-hidden="true">&#9608;</span>
        </div>
        <div class="hero-ctas">
          <a href="#projects" class="btn-primary">View Projects</a>
          <a
            href="/resume.pdf"
            class="btn-secondary"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Download resume, opens in new tab"
          >
            Resume
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
          <a
            href="https://github.com/parvpatodia"
            class="btn-icon"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub profile, opens in new tab"
            title="GitHub"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          </a>
          <a
            href="https://www.linkedin.com/in/parvpatodia"
            class="btn-icon"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn profile, opens in new tab"
            title="LinkedIn"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.13 1.44-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" aria-label="About Parv Patodia">
      <div class="container">
        <div class="section-heading-wrap">
          <span class="section-number" aria-hidden="true">01</span>
          <h2 class="section-heading scramble-heading fade-in">About</h2>
        </div>
        <div class="section-line fade-in"></div>
        <div class="about-grid">
          <div class="about-photo-wrap fade-in">
            <img src="/headshot.png" alt="Parv Patodia" class="about-photo-img" width="180" height="180" loading="lazy" decoding="async" />
          </div>
          <div class="about-text fade-in">
            <p>I started out curious about how machines move through the world. That curiosity grew into a deeper interest in how they perceive, reason, and make decisions from data.</p>
            <p>At Venti Technologies I tested autonomous vehicle perception systems in live port environments, including lane-change validation, LiDAR data analysis, and obstacle detection in real conditions. That experience taught me how different deployment is from a controlled setting and made me take edge cases seriously.</p>
            <p>Since then I have been building closer to the models. I implemented a Vision Transformer from scratch to detect urban change in satellite imagery, built a pose estimation pipeline that analyzes basketball shooting mechanics and matches them against NBA players, and I am currently working on closed-loop driving policy research using nuPlan and CARLA.</p>
            <p>I am pursuing my Master's in Artificial Intelligence at Northeastern University in Silicon Valley. I am most interested in roles where perception, policy, and real-world deployment come together.</p>
          </div>
        </div>

        <!-- Personal stats row -->
        <div class="stats-row fade-in" aria-label="Key stats">
          <div class="stat-item">
            <span class="stat-number count-up" data-target="3">0</span>
            <span class="stat-label">yrs<br>shipping<br>code</span>
          </div>
          <div class="stat-item">
            <span class="stat-number count-up" data-target="2">0</span>
            <span class="stat-label">countries<br>worked<br>in</span>
          </div>
          <div class="stat-item">
            <span class="stat-number stat-plus count-up" data-target="500">0</span>
            <span class="stat-label">NBA<br>players<br>indexed</span>
          </div>
          <div class="stat-item">
            <span class="stat-number count-up" data-target="637">0</span>
            <span class="stat-label">satellite<br>pairs<br>trained</span>
          </div>
        </div>
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section id="experience" aria-label="Work experience">
      <div class="container">
        <div class="section-heading-wrap">
          <span class="section-number" aria-hidden="true">02</span>
          <h2 class="section-heading scramble-heading fade-in">Experience</h2>
        </div>
        <div class="section-line fade-in"></div>
        <div class="experience-list">

          <article class="exp-item fade-in" aria-label="Graduate Teaching Assistant at Northeastern University">
            <div class="exp-dot" aria-hidden="true"></div>
            <div class="exp-header">
              <div class="exp-title">Graduate Teaching Assistant, Foundations of AI</div>
              <div class="exp-meta">
                <span class="exp-company">Northeastern University</span>
                <span class="exp-location">San Jose, CA</span>
                <span class="exp-period">Jan 2026 &ndash; Present</span>
              </div>
            </div>
            <ul class="exp-bullets">
              <li>Led weekly office hours for 30+ students covering model reasoning, debugging, and ML evaluation</li>
              <li>Designed course assignments on dataset selection, model architecture decisions, and result interpretation</li>
            </ul>
          </article>

          <article class="exp-item fade-in" aria-label="Senior Officer SRE at United Overseas Bank">
            <div class="exp-dot" aria-hidden="true"></div>
            <div class="exp-header">
              <div class="exp-title">Senior Officer, Site Reliability Engineering</div>
              <div class="exp-meta">
                <span class="exp-company">United Overseas Bank</span>
                <span class="exp-location">Singapore</span>
                <span class="exp-period">Jul 2024 &ndash; Jun 2025</span>
              </div>
            </div>
            <ul class="exp-bullets">
              <li>Monitored production banking infrastructure using GENEOS; improved incident visibility by 30%</li>
              <li>Ran scalability checks across AWS and VMware systems under peak production loads</li>
            </ul>
          </article>

          <article class="exp-item exp-item--av fade-in" aria-label="Autonomous Vehicle Test Engineer at Venti Technologies">
            <div class="exp-dot exp-dot--av" aria-hidden="true"></div>
            <div class="exp-header">
              <div class="exp-title">Autonomous Vehicle Test Engineer</div>
              <div class="exp-meta">
                <span class="exp-company exp-company--av">Venti Technologies</span>
                <span class="exp-location">Singapore</span>
                <span class="exp-period">Jun 2023 &ndash; Aug 2023</span>
                <span class="stack-tag exp-av-tag">Autonomous Vehicles</span>
              </div>
            </div>
            <ul class="exp-bullets">
              <li>Designed validation tests for lane-change and perception modules using RViz simulation and LiDAR data analysis</li>
              <li>Reduced testing cycle time by 15% by improving validation workflows with Git and Jira</li>
            </ul>
          </article>

        </div>
      </div>
    </section>

    <!-- PROJECTS -->
    <section id="projects" aria-label="Projects">
      <div class="container">
        <div class="section-heading-wrap">
          <span class="section-number" aria-hidden="true">03</span>
          <h2 class="section-heading scramble-heading fade-in">Projects</h2>
        </div>
        <div class="section-line fade-in"></div>

        <h3 class="projects-subheading fade-in">Featured</h3>

        <!-- Featured: Laksh.ai - full-width editorial card -->
        <article class="featured-card fade-in tilt-card" aria-label="Laksh.ai project">
          <!-- Basketball shot arc decoration -->
          <svg class="shot-arc-svg" aria-hidden="true" viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">
            <path d="M12,68 C12,30 50,18 68,12" fill="none" stroke="var(--accent-green)" stroke-width="2" stroke-linecap="round"/>
            <polyline points="62,8 68,12 64,18" fill="none" stroke="var(--accent-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <div class="featured-card-inner">
            <div class="featured-card-left">
              <div class="card-header">
                <h4 class="card-title">Laksh.ai</h4>
                <span class="status-badge status-active">Active</span>
              </div>
              <p class="card-period">Dec 2025 &ndash; Present</p>
              <div class="stack-tags">
                <span class="stack-tag">Python</span>
                <span class="stack-tag">FastAPI</span>
                <span class="stack-tag">MediaPipe</span>
                <span class="stack-tag">RTMPose</span>
                <span class="stack-tag">YOLOv8</span>
                <span class="stack-tag">ChromaDB</span>
                <span class="stack-tag">Gemini 2.5 Flash</span>
              </div>
              <p class="card-description">Computer vision pipeline for basketball jump-shot analysis using markerless pose estimation and ball tracking. Integrates MediaPipe and RTMPose into a pluggable pose architecture that generates a canonical 12-joint schema for kinematic analysis. Extracts an 8D kinematic fingerprint matched against NBA player profiles via ChromaDB vector search with LLM-generated coaching feedback. Implements injury-risk indicators including knee valgus, landing mechanics, and upper-extremity load derived from pose trajectories.</p>
              <div class="card-origin-note">Shipped at YC x Google DeepMind Hackathon &bull; with Yashvardhan Gupta, Dishaa Bornare, Vineeth Sakhamuru</div>
              <span class="card-metric"><span class="count-up" data-target="500">0</span>+ NBA players indexed</span>
              <a
                href="https://github.com/parvpatodia/Laksh_AI"
                target="_blank"
                rel="noopener noreferrer"
                class="card-link"
                aria-label="View Laksh.ai on GitHub (opens in new tab)"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                View on GitHub
              </a>
            </div>
            <div class="featured-card-right">
              <!-- System pipeline diagram -->
              <svg class="pipeline-svg" viewBox="0 0 230 308" xmlns="http://www.w3.org/2000/svg" aria-label="Laksh.ai system pipeline">
                <!-- Stage: Video Input -->
                <rect x="0" y="0" width="230" height="42" rx="3" fill="rgba(6,182,212,0.06)" stroke="rgba(6,182,212,0.22)" stroke-width="1"/>
                <text x="10" y="14" font-size="8" fill="#4B5563" letter-spacing="1">INPUT</text>
                <text x="10" y="30" font-size="11" font-weight="600" fill="#E2E8F0">Video Frame</text>
                <text x="180" y="30" font-size="9" fill="#06B6D4">mp4 / rtsp</text>
                <!-- connector -->
                <line x1="115" y1="42" x2="115" y2="54" stroke="#1F2937" stroke-width="1" stroke-dasharray="3,2"/>
                <polygon points="111,52 115,58 119,52" fill="#1F2937"/>
                <!-- Stage 01: Pose -->
                <rect x="0" y="58" width="230" height="48" rx="3" fill="rgba(6,182,212,0.06)" stroke="rgba(6,182,212,0.22)" stroke-width="1"/>
                <text x="10" y="72" font-size="8" fill="#4B5563" letter-spacing="1">STAGE 01</text>
                <text x="10" y="87" font-size="11" font-weight="600" fill="#E2E8F0">Pose Estimation</text>
                <text x="10" y="99" font-size="9" fill="#06B6D4">MediaPipe + RTMPose (pluggable)</text>
                <!-- connector -->
                <line x1="115" y1="106" x2="115" y2="118" stroke="#1F2937" stroke-width="1" stroke-dasharray="3,2"/>
                <polygon points="111,116 115,122 119,116" fill="#1F2937"/>
                <!-- Stage 02: Schema -->
                <rect x="0" y="122" width="230" height="48" rx="3" fill="rgba(59,130,246,0.06)" stroke="rgba(59,130,246,0.22)" stroke-width="1"/>
                <text x="10" y="136" font-size="8" fill="#4B5563" letter-spacing="1">STAGE 02</text>
                <text x="10" y="151" font-size="11" font-weight="600" fill="#E2E8F0">12-Joint Canonical Schema</text>
                <text x="10" y="163" font-size="9" fill="#3B82F6">8D kinematic fingerprint vector</text>
                <!-- connector -->
                <line x1="115" y1="170" x2="115" y2="182" stroke="#1F2937" stroke-width="1" stroke-dasharray="3,2"/>
                <polygon points="111,180 115,186 119,180" fill="#1F2937"/>
                <!-- Stage 03: Retrieval -->
                <rect x="0" y="186" width="230" height="48" rx="3" fill="rgba(59,130,246,0.06)" stroke="rgba(59,130,246,0.22)" stroke-width="1"/>
                <text x="10" y="200" font-size="8" fill="#4B5563" letter-spacing="1">STAGE 03</text>
                <text x="10" y="215" font-size="11" font-weight="600" fill="#E2E8F0">ChromaDB Vector Search</text>
                <text x="10" y="227" font-size="9" fill="#3B82F6">500+ NBA player profiles indexed</text>
                <!-- connector -->
                <line x1="115" y1="234" x2="115" y2="246" stroke="#1F2937" stroke-width="1" stroke-dasharray="3,2"/>
                <polygon points="111,244 115,250 119,244" fill="#1F2937"/>
                <!-- Stage: Output -->
                <rect x="0" y="250" width="230" height="48" rx="3" fill="rgba(16,185,129,0.06)" stroke="rgba(16,185,129,0.22)" stroke-width="1"/>
                <text x="10" y="264" font-size="8" fill="#4B5563" letter-spacing="1">OUTPUT</text>
                <text x="10" y="279" font-size="11" font-weight="600" fill="#E2E8F0">Coaching Feedback + Risk Flags</text>
                <text x="10" y="291" font-size="9" fill="#10B981">Gemini 2.5 Flash</text>
              </svg>
            </div>
          </div>
        </article>

        <!-- Featured: ViT - full-width editorial card -->
        <article class="featured-card fade-in tilt-card" aria-label="Vision Transformer for Urban Change Detection project" style="margin-bottom:3.5rem;">
          <div class="featured-card-inner">
            <div class="featured-card-left">
              <div class="card-header">
                <h4 class="card-title">Vision Transformer for Urban Change Detection</h4>
                <span class="status-badge status-active">Active</span>
              </div>
              <p class="card-period">Jan 2025 &ndash; Present</p>
              <div class="stack-tags">
                <span class="stack-tag">PyTorch</span>
                <span class="stack-tag">Albumentations</span>
                <span class="stack-tag">TensorBoard</span>
                <span class="stack-tag">LEVIR-CD</span>
              </div>
              <p class="card-description">Implemented a Vision Transformer from scratch in PyTorch for bi-temporal change detection using Sentinel-2 satellite imagery. Built patch embedding, positional encoding, multi-head self-attention, and transformer encoder blocks without pretrained modules. Built a Siamese encoder architecture with a segmentation decoder for urban growth detection. Produced segmentation change maps and evaluated performance using IoU, F1, Dice, precision, and recall against CNN baselines.</p>
              <a
                href="https://github.com/parvpatodia/vit-from-scratch"
                target="_blank"
                rel="noopener noreferrer"
                class="card-link"
                aria-label="View ViT project on GitHub (opens in new tab)"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
                View on GitHub
              </a>
            </div>
            <div class="featured-card-right">
              <table class="results-table" aria-label="Model performance comparison">
                <thead>
                  <tr>
                    <th>Model</th>
                    <th>F1</th>
                    <th>IoU</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>U-Net</td>
                    <td>0.8843</td>
                    <td>0.7927</td>
                  </tr>
                  <tr>
                    <td>Swin</td>
                    <td>0.8613</td>
                    <td>0.7564</td>
                  </tr>
                  <tr>
                    <td>ViT</td>
                    <td>0.8236</td>
                    <td>0.7001</td>
                  </tr>
                </tbody>
              </table>
              <!-- Attention map canvas -->
              <div class="attn-map-wrap" aria-label="Live attention map visualization from ViT encoder">
                <div class="attn-map-label">
                  <span class="attn-label-text">Encoder attention weights / head 3 / layer 6</span>
                  <span class="attn-label-badge">live</span>
                </div>
                <canvas id="attn-canvas" width="224" height="224" style="width:100%;max-width:224px;display:block;margin:0 auto;border-radius:4px;"></canvas>
                <div class="attn-map-hint">hover a patch to highlight attention</div>
              </div>
            </div>
          </div>
        </article>

