<script>
// ─── Reduced-motion preference (gates the JS-driven animations below) ───────────
const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

// ─── Typewriter ───────────────────────────────────────────────────────────────
const strings: string[] = [
  "Building closed-loop driving policies for autonomous vehicles",
  "Implementing transformers from first principles for satellite imagery",
  "Modeling basketball biomechanics using markerless pose estimation",
  "Shipping multimodal RAG with ColPali and CLIP for document retrieval"
];

const twEl = document.getElementById("typewriter-text");
if (twEl && reduceMotion) {
  twEl.textContent = strings[0];
} else if (twEl) {
  let si = 0;
  let ci = 0;
  let deleting = false;
  const TYPE_SPEED  = 48;
  const DEL_SPEED   = 24;
  const PAUSE_FULL  = 2400;
  const PAUSE_EMPTY = 400;

  function tick() {
    const str = strings[si];
    if (!deleting) {
      twEl.textContent = str.slice(0, ci + 1);
      ci++;
      if (ci === str.length) {
        deleting = true;
        setTimeout(tick, PAUSE_FULL);
        return;
      }
      setTimeout(tick, TYPE_SPEED);
    } else {
      twEl.textContent = str.slice(0, ci - 1);
      ci--;
      if (ci === 0) {
        deleting = false;
        si = (si + 1) % strings.length;
        setTimeout(tick, PAUSE_EMPTY);
        return;
      }
      setTimeout(tick, DEL_SPEED);
    }
  }
  setTimeout(tick, 700);
}

// ─── Scroll fade-in ───────────────────────────────────────────────────────────
const fadeEls = document.querySelectorAll<HTMLElement>(".fade-in");
const fadeObserver = new IntersectionObserver(
  (entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
        fadeObserver.unobserve(entry.target);
      }
    });
  },
  { threshold: 0.1 }
);
fadeEls.forEach((el) => fadeObserver.observe(el));

// ─── Nav hide/show on scroll ──────────────────────────────────────────────────
const navbar = document.getElementById("navbar");
let lastScrollY = window.scrollY;
window.addEventListener(
  "scroll",
  () => {
    const y = window.scrollY;
    if (y < 80) {
      navbar?.classList.remove("hidden");
    } else if (y > lastScrollY + 8) {
      navbar?.classList.add("hidden");
    } else if (y < lastScrollY - 8) {
      navbar?.classList.remove("hidden");
    }
    lastScrollY = y;
  },
  { passive: true }
);

// ─── Scroll progress bar ─────────────────────────────────────────────────────
const progressBar = document.getElementById("scroll-progress");
if (progressBar) {
  window.addEventListener("scroll", () => {
    const max = document.body.scrollHeight - window.innerHeight;
    progressBar.style.width = (window.scrollY / max * 100) + "%";
  }, { passive: true });
}

// ─── Active section nav highlight + breadcrumb ───────────────────────────────
const sectionIds = ["about", "experience", "projects", "research", "hackathons", "beyond-code", "skills", "contact"];
const navAnchors = document.querySelectorAll<HTMLAnchorElement>(".nav-links a");
const breadcrumb = document.getElementById("nav-breadcrumb");

const sectionObserver = new IntersectionObserver(
  (entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        navAnchors.forEach((a) => {
          a.classList.toggle("active", a.getAttribute("href") === "#" + entry.target.id);
        });
        if (breadcrumb) {
          breadcrumb.textContent = "/ " + entry.target.id;
        }
      }
    });
  },
  { rootMargin: "-40% 0px -55% 0px" }
);
sectionIds.forEach((id) => {
  const sec = document.getElementById(id);
  if (sec) sectionObserver.observe(sec);
});

// ─── Mobile hamburger ─────────────────────────────────────────────────────────
const hamburger = document.getElementById("hamburger");
const mobileMenu = document.getElementById("mobile-menu");
hamburger?.addEventListener("click", () => {
  const isOpen = mobileMenu?.classList.toggle("open") ?? false;
  hamburger.setAttribute("aria-expanded", String(isOpen));
});
mobileMenu?.querySelectorAll("a").forEach((a) => {
  a.addEventListener("click", () => {
    mobileMenu.classList.remove("open");
    hamburger?.setAttribute("aria-expanded", "false");
  });
});

// ─── 3D card tilt ─────────────────────────────────────────────────────────────
if (!reduceMotion) document.querySelectorAll<HTMLElement>(".tilt-card").forEach((card) => {
  card.addEventListener("mousemove", (e: MouseEvent) => {
    const r = card.getBoundingClientRect();
    const x = e.clientX - r.left;
    const y = e.clientY - r.top;
    const rotY =  ((x - r.width  / 2) / (r.width  / 2)) * 5;
    const rotX = -((y - r.height / 2) / (r.height / 2)) * 5;
    card.style.transform = `perspective(1000px) rotateX(${rotX}deg) rotateY(${rotY}deg)`;
    card.style.transition = "transform 0.05s ease";
  });
  card.addEventListener("mouseleave", () => {
    card.style.transform = "perspective(1000px) rotateX(0deg) rotateY(0deg)";
    card.style.transition = "transform 0.3s ease";
  });
});

// ─── Count-up animation ───────────────────────────────────────────────────────
const countEls = document.querySelectorAll<HTMLElement>(".count-up");

function easeOut(t: number): number {
  return 1 - Math.pow(1 - t, 3);
}

function animateCount(el: HTMLElement) {
  const target = parseInt(el.dataset.target ?? "0", 10);
  const duration = 1200;
  const start = performance.now();

  function step(now: number) {
    const elapsed = now - start;
    const progress = Math.min(elapsed / duration, 1);
    const value = Math.round(easeOut(progress) * target);
    el.textContent = String(value);
    if (progress < 1) {
      requestAnimationFrame(step);
    } else {
      el.textContent = String(target);
    }
  }
  requestAnimationFrame(step);
}

const countObserver = new IntersectionObserver(
  (entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        animateCount(entry.target as HTMLElement);
        countObserver.unobserve(entry.target);
      }
    });
  },
  { threshold: 0.3 }
);

countEls.forEach((el) => {
  if (reduceMotion) { el.textContent = el.dataset.target ?? "0"; }
  else { countObserver.observe(el); }
});

// ─── Precision dual-ring cursor ──────────────────────────────────────────────
const cursorRing     = document.querySelector<HTMLElement>(".cursor-ring");
const cursorDotInner = document.querySelector<HTMLElement>(".cursor-dot-inner");

if (cursorRing && cursorDotInner && !reduceMotion && window.matchMedia("(pointer: fine)").matches) {
  cursorRing.style.display     = "block";
  cursorDotInner.style.display = "block";

  let mouseX = 0, mouseY = 0;
  let ringX  = 0, ringY  = 0;

  document.addEventListener("mousemove", (e: MouseEvent) => {
    mouseX = e.clientX;
    mouseY = e.clientY;
    cursorDotInner.style.transform = `translate(${mouseX - 2}px, ${mouseY - 2}px)`;
  });

  (function animateRing() {
    ringX += (mouseX - ringX) * 0.11;
    ringY += (mouseY - ringY) * 0.11;
    cursorRing.style.transform = `translate(${ringX - 15}px, ${ringY - 15}px)`;
    requestAnimationFrame(animateRing);
  })();

  document.querySelectorAll<HTMLElement>(
    "a, button, .featured-card, .past-card, .hackathon-card, .beyond-card, canvas"
  ).forEach((el) => {
    el.addEventListener("mouseenter", () => cursorRing.classList.add("cursor-ring--hover"));
    el.addEventListener("mouseleave", () => cursorRing.classList.remove("cursor-ring--hover"));
  });
}

// ─── Text scramble on section headings ───────────────────────────────────────
const SCRAMBLE_CHARS = "!<>-_\\/[]{}=+*^?#01";

function scrambleText(el: HTMLElement) {
  const final = el.dataset.finalText ?? el.textContent ?? "";
  if (!el.dataset.finalText) el.dataset.finalText = final;
  let iter = 0;
  const iv = setInterval(() => {
    el.textContent = final.split("").map((ch, i) => {
      if (ch === " ") return " ";
      if (i < iter)   return ch;
      return SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
    }).join("");
    iter += 0.4;
    if (iter > final.length) { el.textContent = final; clearInterval(iv); }
  }, 38);
}

const scrambleObs = new IntersectionObserver(
  (entries) => entries.forEach((e) => {
    if (e.isIntersecting) { scrambleText(e.target as HTMLElement); scrambleObs.unobserve(e.target); }
  }),
  { threshold: 0.5 }
);
if (!reduceMotion) document.querySelectorAll<HTMLElement>(".scramble-heading").forEach((el) => scrambleObs.observe(el));

// ─── Magnetic buttons ────────────────────────────────────────────────────────
if (!reduceMotion) document.querySelectorAll<HTMLElement>(".btn-primary, .btn-secondary").forEach((btn) => {
  btn.addEventListener("mousemove", (e: MouseEvent) => {
    const r  = btn.getBoundingClientRect();
    const dx = e.clientX - (r.left + r.width  / 2);
    const dy = e.clientY - (r.top  + r.height / 2);
    btn.style.transform  = `translate(${dx * 0.17}px, ${dy * 0.17}px)`;
    btn.style.transition = "transform 0.08s ease";
  });
  btn.addEventListener("mouseleave", () => {
    btn.style.transform  = "translate(0,0)";
    btn.style.transition = "transform 0.4s cubic-bezier(0.22,1,0.36,1)";
  });
});

// ─── Boot sequence (plays once per session) ───────────────────────────────────
const bootOverlay = document.getElementById("boot-overlay");
const bootNameEl  = document.getElementById("boot-name");
if (bootOverlay && bootNameEl && !reduceMotion && !sessionStorage.getItem("booted")) {
  sessionStorage.setItem("booted", "1");
  const bootStr = "Parv Patodia";
  let bi = 0;
  const bootInterval = setInterval(() => {
    bootNameEl.textContent = bootStr.slice(0, bi + 1);
    bi++;
    if (bi >= bootStr.length) {
      clearInterval(bootInterval);
      setTimeout(() => {
        bootOverlay.classList.add("done");
        setTimeout(() => bootOverlay.remove(), 500);
      }, 350);
    }
  }, 50);
} else {
  bootOverlay?.remove();
}

// ─── Attention map canvas (ViT section) ───────────────────────────────────────
const attnCanvas = document.getElementById("attn-canvas") as HTMLCanvasElement | null;
if (attnCanvas) {
  const ctx = attnCanvas.getContext("2d")!;
  const N = 7; // 7×7 grid of patches (simulates ViT-S/32 over 224px)
  const W = attnCanvas.width;
  const H = attnCanvas.height;
  const cellW = W / N;
  const cellH = H / N;

  // Three pre-baked attention patterns (row-major, 49 values each)
  function softmax(arr: number[]): number[] {
    const max = Math.max(...arr);
    const exps = arr.map(v => Math.exp(v - max));
    const sum = exps.reduce((a, b) => a + b, 0);
    return exps.map(v => v / sum);
  }
  function makePattern(fn: (r: number, c: number) => number): number[] {
    const raw: number[] = [];
    for (let r = 0; r < N; r++) for (let c = 0; c < N; c++) raw.push(fn(r, c));
    return softmax(raw);
  }

  const patterns: number[][] = [
    // Center-focus: high attention toward middle patches
    makePattern((r, c) => {
      const dr = r - (N - 1) / 2, dc = c - (N - 1) / 2;
      return 4 - (dr * dr + dc * dc) * 0.9;
    }),
    // Diagonal band: attention along main diagonal
    makePattern((r, c) => {
      const diff = Math.abs(r - c);
      return diff === 0 ? 4 : diff === 1 ? 2 : diff === 2 ? 0.5 : -1;
    }),
    // Top-left quadrant / corner focus
    makePattern((r, c) => {
      return (r < 4 && c < 4) ? 3 - r * 0.4 - c * 0.4 : -0.5;
    }),
  ];

  let t = 0;
  let hoveredCell = -1;

  // Viridis-like colormap: dark navy -> cyan -> yellow-green
  function viridis(v: number): string {
    const r = Math.round(68  + v * (253 - 68));
    const g = Math.round(1   + v * (231 - 1));
    const b = Math.round(84  + v * (37  - 84));
    return `rgb(${r},${g},${b})`;
  }

  function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }

  function getWeight(patIdx: number, next: number, blend: number, i: number): number {
    return lerp(patterns[patIdx][i], patterns[next][i], blend);
  }

  function draw() {
    const speed = 0.0008;
    const cyclePos = (t * speed) % 1;
    const segLen = 1 / patterns.length;
    const seg = Math.floor(cyclePos / segLen);
    const blend = (cyclePos % segLen) / segLen;
    const nextSeg = (seg + 1) % patterns.length;

    // Softmax-weighted attention for highlighted cell
    let rowWeights: number[] = [];
    if (hoveredCell >= 0) {
      for (let j = 0; j < N * N; j++) {
        rowWeights.push(getWeight(seg, nextSeg, blend, j));
      }
      // Normalize so hovered row sums to 1
      const rowSum = rowWeights.reduce((s, v) => s + v, 0);
      rowWeights = rowWeights.map(v => v / rowSum);
    }

    ctx.clearRect(0, 0, W, H);

    for (let r = 0; r < N; r++) {
      for (let c = 0; c < N; c++) {
        const i = r * N + c;
        let w = getWeight(seg, nextSeg, blend, i);
        // Scale: map [min, max] -> [0,1]
        const pat = patterns[seg];
        const wMin = Math.min(...pat), wMax = Math.max(...pat);
        w = (w - wMin) / (wMax - wMin + 1e-8);

        let alpha = 0.82;
        if (hoveredCell >= 0) {
          // Highlight: use attention from hovered cell to all others
          const hw = rowWeights[i] / Math.max(...rowWeights);
          w = hw;
          alpha = i === hoveredCell ? 1 : 0.7;
        }

        ctx.fillStyle = viridis(w);
        ctx.globalAlpha = alpha;
        ctx.fillRect(c * cellW + 1, r * cellH + 1, cellW - 2, cellH - 2);

        // Hovered cell border
        if (i === hoveredCell) {
          ctx.globalAlpha = 1;
          ctx.strokeStyle = "#ffffff";
          ctx.lineWidth = 1.5;
          ctx.strokeRect(c * cellW + 1, r * cellH + 1, cellW - 2, cellH - 2);
        }
      }
    }
    ctx.globalAlpha = 1;
    t++;
    if (!reduceMotion) requestAnimationFrame(draw);
  }

  attnCanvas.addEventListener("mousemove", (e: MouseEvent) => {
    const rect = attnCanvas.getBoundingClientRect();
    const scaleX = W / rect.width;
    const scaleY = H / rect.height;
    const px = (e.clientX - rect.left) * scaleX;
    const py = (e.clientY - rect.top)  * scaleY;
    const col = Math.floor(px / cellW);
    const row = Math.floor(py / cellH);
    hoveredCell = (row >= 0 && row < N && col >= 0 && col < N) ? row * N + col : -1;
  });
  attnCanvas.addEventListener("mouseleave", () => { hoveredCell = -1; });

  draw();
}
</script>
