---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Parv Patodia | AI/ML & Robotics Engineer',
  description = 'Parv Patodia, MS AI at Northeastern (Silicon Valley). I build ML systems for perception and decision-making across autonomous vehicles and robotics. Open to a Fall 2026 co-op.'
} = Astro.props;

const siteUrl = 'https://parvpatodia.vercel.app';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = `${siteUrl}/og-image.png`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Parv Patodia',
  url: siteUrl,
  image: `${siteUrl}/headshot.png`,
  jobTitle: 'AI/ML Engineer',
  description,
  email: 'mailto:parvpatodia09@gmail.com',
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Northeastern University' },
    { '@type': 'CollegeOrUniversity', name: 'Nanyang Technological University' }
  ],
  knowsAbout: [
    'Machine Learning',
    'Computer Vision',
    'Autonomous Vehicles',
    'Robotics',
    'Deep Learning',
    'Transformers'
  ],
  sameAs: [
    'https://github.com/parvpatodia',
    'https://www.linkedin.com/in/parvpatodia'
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Parv Patodia" />
  <meta name="theme-color" content="#0A0E1A" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Preconnect for faster font loading (fonts are requested from the CSS) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Parv Patodia" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Parv Patodia, AI/ML Engineer. Autonomous vehicles, robotics, ML systems." />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Inline SVG favicon: "P" in accent blue -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%230A0E1A'/><text x='50%25' y='72%25' dominant-baseline='middle' text-anchor='middle' font-family='Georgia,serif' font-size='20' font-weight='700' fill='%233B82F6'>P</text></svg>" />

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
</head>
<body>
  <slot />
</body>
</html>
