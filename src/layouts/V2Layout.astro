---
import '../styles/v2.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  nav?: string;
}
const {
  title,
  description = 'Parv Patodia, MS AI at Northeastern (Silicon Valley). I build ML systems for perception and decision-making across autonomous vehicles and robotics. Open to a Fall 2026 co-op.',
  nav = ''
} = Astro.props;

const siteUrl = 'https://parvpatodia.vercel.app';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = `${siteUrl}/og-image.png`;

const links = [
  { href: '/work', label: 'work', key: 'work' },
  { href: '/story', label: 'story', key: 'story' },
  { href: '/beyond', label: 'beyond', key: 'beyond' },
  { href: '/contact', label: 'contact', key: 'contact' }
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Parv Patodia',
  url: siteUrl,
  image: `${siteUrl}/headshot.png`,
  jobTitle: 'AI/ML Engineer',
  description,
  email: 'mailto:parvpatodia09@gmail.com',
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Northeastern University' },
    { '@type': 'CollegeOrUniversity', name: 'Nanyang Technological University' }
  ],
  knowsAbout: ['Machine Learning', 'Computer Vision', 'Autonomous Vehicles', 'Robotics', 'Deep Learning', 'Transformers'],
  sameAs: ['https://github.com/parvpatodia', 'https://www.linkedin.com/in/parvpatodia-ai-silicon-valley']
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Parv Patodia" />
  <meta name="theme-color" content="#0A0A0C" />
  <link rel="canonical" href={canonicalURL} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Parv Patodia" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Parv Patodia, AI/ML Engineer. Autonomous vehicles, robotics, ML systems." />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%230A0A0C'/><text x='50%25' y='73%25' dominant-baseline='middle' text-anchor='middle' font-family='Georgia,serif' font-size='20' font-weight='700' fill='%23F2B33D'>P</text></svg>" />

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <ClientRouter />
</head>
<body>
  <div class="grain" aria-hidden="true" transition:persist></div>
  <div class="cursor-ring" aria-hidden="true" transition:persist></div>

  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="logo">Parv Patodia<span class="dot">.</span></a>
      <ul class="nav-links">
        {links.map((l) => (
          <li><a href={l.href} aria-current={nav === l.key ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <span class="nav-right">
        <span class="status"><span class="pulse" aria-hidden="true"></span>Fall 2026 co-op</span>
        <button class="cmdk-trigger" type="button" data-cmdk-open aria-label="Open command palette (Command or Control K)">&#8984;K</button>
      </span>
    </div>
  </nav>

  <slot />

  <footer class="foot">
    <div class="foot-inner">
      <span>&copy; 2026 Parv Patodia &middot; San Jose, CA &middot; built without templates</span>
      <span>
        <a href="https://github.com/parvpatodia" target="_blank" rel="noopener noreferrer">github</a> &middot;
        <a href="https://www.linkedin.com/in/parvpatodia-ai-silicon-valley" target="_blank" rel="noopener noreferrer">linkedin</a> &middot;
        <a href="mailto:parvpatodia09@gmail.com">email</a>
      </span>
    </div>
  </footer>

  <div id="cmdk" class="cmdk" role="dialog" aria-modal="true" aria-label="Command palette" hidden transition:persist>
    <div class="cmdk-backdrop" data-cmdk-close></div>
    <div class="cmdk-panel">
      <input id="cmdk-input" class="cmdk-input" type="text" role="combobox" aria-expanded="false" aria-controls="cmdk-list" aria-autocomplete="list" placeholder="Jump to a page or link..." aria-label="Search commands" autocomplete="off" spellcheck="false" />
      <ul id="cmdk-list" class="cmdk-list" role="listbox" aria-label="Commands"></ul>
    </div>
  </div>

  <script>
    import { navigate } from 'astro:transitions/client';

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = window.matchMedia('(pointer: fine)').matches && window.matchMedia('(hover: hover)').matches;

    // ── Cursor ring (singleton; element persists across navigations) ────────────
    (function cursor() {
      if (!(fine && !reduce)) return;
      const ring = document.querySelector('.cursor-ring');
      if (!(ring instanceof HTMLElement)) return;
      let rx = 0, ry = 0, tx = 0, ty = 0, shown = false, run = false;
      const loop = () => {
        rx += (tx - rx) * 0.2; ry += (ty - ry) * 0.2;
        ring.style.transform = `translate(${rx}px, ${ry}px)`;
        if (Math.abs(tx - rx) + Math.abs(ty - ry) < 0.1) { run = false; return; }
        requestAnimationFrame(loop);
      };
      const kick = () => { if (!run) { run = true; requestAnimationFrame(loop); } };
      window.addEventListener('mousemove', (e) => {
        tx = e.clientX; ty = e.clientY;
        if (!shown) { shown = true; ring.classList.add('on'); rx = tx; ry = ty; }
        kick();
      }, { passive: true });
      document.addEventListener('mouseover', (e) => { const t = e.target; if (t instanceof Element && t.closest('a, button')) ring.classList.add('hover'); });
      document.addEventListener('mouseout', (e) => { const t = e.target; if (t instanceof Element && t.closest('a, button')) ring.classList.remove('hover'); });
    })();

    // ── Magnetic buttons (re-bound each navigation; guarded against double-bind) ─
    function bindMagnetic() {
      if (!(fine && !reduce)) return;
      document.querySelectorAll('.btn').forEach((el) => {
        const btn = el as HTMLElement & { _mag?: boolean };
        if (btn._mag) return; btn._mag = true;
        let cx = 0, cy = 0;
        btn.addEventListener('mouseenter', () => { const r = btn.getBoundingClientRect(); cx = r.left + r.width / 2; cy = r.top + r.height / 2; });
        btn.addEventListener('mousemove', (e) => { btn.style.transform = `translate(${((e as MouseEvent).clientX - cx) * 0.18}px, ${((e as MouseEvent).clientY - cy) * 0.18}px)`; });
        btn.addEventListener('mouseleave', () => { btn.style.transform = ''; });
      });
    }

    // ── Reveal on scroll (re-init each navigation) ──────────────────────────────
    let revealIO: IntersectionObserver | null = null;
    function initReveals() {
      if (revealIO) revealIO.disconnect();
      const els = Array.from(document.querySelectorAll('.reveal'));
      if (reduce) { els.forEach((el) => el.classList.add('in')); return; }
      revealIO = new IntersectionObserver((entries) => {
        entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); revealIO && revealIO.unobserve(en.target); } });
      }, { threshold: 0.12 });
      const vh = window.innerHeight || 800;
      els.forEach((el) => {
        const r = (el as HTMLElement).getBoundingClientRect();
        // Already in view at load/navigation: reveal it (robust even if the
        // observer is throttled, e.g. a backgrounded tab). Below the fold: observe.
        if (r.top < vh * 0.92 && r.bottom > 0) setTimeout(() => el.classList.add('in'), 40);
        else revealIO!.observe(el);
      });
    }

    // ── Diffusion name hero (home only; torn down before each swap) ──────────────
    let heroRaf = 0;
    let heroIO: IntersectionObserver | null = null;
    let heroResize: (() => void) | null = null;
    function destroyHero() {
      cancelAnimationFrame(heroRaf); heroRaf = 0;
      if (heroIO) { heroIO.disconnect(); heroIO = null; }
      if (heroResize) { window.removeEventListener('resize', heroResize); heroResize = null; }
    }
    function initHero() {
      destroyHero();
      const stage = document.getElementById('name-canvas') as HTMLCanvasElement | null;
      const heroEl = document.querySelector('.hero') as HTMLElement | null;
      if (!stage || !heroEl || reduce) return;
      const tEl = document.getElementById('diff-t');
      const resampleBtn = document.getElementById('resample');
      const ctx = stage.getContext('2d')!;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      let w = 0, h = 0;
      type P = { tx: number; ty: number; x: number; y: number; vx: number; vy: number; teal: boolean };
      let parts: P[] = [];
      const mouse = { x: -9999, y: -9999 };
      let running = false, jitter = 0, visible = true;

      function buildTargets() {
        const rect = stage!.getBoundingClientRect();
        w = rect.width; h = rect.height;
        if (w < 2 || h < 2) return;
        stage!.width = Math.floor(w * dpr); stage!.height = Math.floor(h * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const off = document.createElement('canvas');
        off.width = Math.floor(w); off.height = Math.floor(h);
        const octx = off.getContext('2d')!;
        octx.fillStyle = '#fff'; octx.textAlign = 'left'; octx.textBaseline = 'top';
        const lines = ['Parv', 'Patodia'];
        let fontSize = Math.min(h * 0.47, w * 0.34);
        const setFont = () => { octx.font = `700 ${fontSize}px "Bricolage Grotesque", "Space Grotesk", sans-serif`; };
        setFont();
        const widest = Math.max(...lines.map((l) => octx.measureText(l).width));
        if (widest > w * 0.98) { fontSize *= (w * 0.98) / widest; setFont(); }
        const lineH = fontSize * 0.98;
        const y0 = (h - lineH * lines.length) / 2;
        lines.forEach((l, i) => octx.fillText(l, 1, y0 + i * lineH));
        const img = octx.getImageData(0, 0, off.width, off.height).data;
        const gap = w < 520 ? 4 : 5;
        const targets: { x: number; y: number }[] = [];
        for (let y = 0; y < off.height; y += gap)
          for (let x = 0; x < off.width; x += gap)
            if (img[(y * off.width + x) * 4 + 3] > 128) targets.push({ x, y });
        parts = targets.map((t, i) => ({ tx: t.x, ty: t.y, x: Math.random() * w, y: Math.random() * h, vx: 0, vy: 0, teal: i % 12 === 0 }));
      }
      function kick() { if (!running && parts.length && visible) { running = true; heroRaf = requestAnimationFrame(loop); } }
      function renoise() { for (const p of parts) { p.x = Math.random() * w; p.y = Math.random() * h; p.vx = 0; p.vy = 0; } jitter = 7; kick(); }
      function loop() {
        if (!visible) { running = false; return; }
        ctx.clearRect(0, 0, w, h);
        const k = 0.03, damp = 0.84, R = 72;
        let totalD = 0, totalV = 0;
        for (const p of parts) {
          p.vx += (p.tx - p.x) * k; p.vy += (p.ty - p.y) * k;
          const dx = p.x - mouse.x, dy = p.y - mouse.y, d2 = dx * dx + dy * dy;
          if (d2 < R * R) { const d = Math.sqrt(d2) || 1; const f = (1 - d / R) * 4.5; p.vx += (dx / d) * f; p.vy += (dy / d) * f; }
          p.vx *= damp; p.vy *= damp;
          p.x += p.vx + (Math.random() - 0.5) * jitter; p.y += p.vy + (Math.random() - 0.5) * jitter;
          totalV += Math.abs(p.vx) + Math.abs(p.vy);
          const dist = Math.abs(p.tx - p.x) + Math.abs(p.ty - p.y);
          totalD += dist;
          ctx.fillStyle = (p.teal ? 'rgba(52,214,192,' : 'rgba(242,179,61,') + (dist < 1.6 ? 0.92 : 0.5) + ')';
          ctx.fillRect(p.x, p.y, 1.7, 1.7);
        }
        jitter *= 0.95;
        if (tEl) { const t = Math.round(Math.max(0, Math.min(1, (totalD / parts.length) / 55)) * 1000); tEl.textContent = t > 4 ? `denoising · t=${String(t).padStart(4, '0')}` : 'sampled · t=0000'; }
        const idle = mouse.x < -9000;
        if (idle && jitter < 0.15 && totalV / parts.length < 0.04) { running = false; return; }
        heroRaf = requestAnimationFrame(loop);
      }
      const start = () => { buildTargets(); if (parts.length) { heroEl.classList.add('canvas-on'); jitter = 7; kick(); } };
      const fonts = (document as any).fonts;
      if (fonts && fonts.ready) fonts.ready.then(start); else start();
      heroIO = new IntersectionObserver((es) => { visible = es[0].isIntersecting; if (visible) kick(); }, { threshold: 0 });
      heroIO.observe(heroEl);
      let rz = 0;
      heroResize = () => { clearTimeout(rz); rz = window.setTimeout(() => { buildTargets(); kick(); }, 200); };
      window.addEventListener('resize', heroResize, { passive: true });
      stage.addEventListener('mousemove', (e) => { const r = stage.getBoundingClientRect(); mouse.x = (e as MouseEvent).clientX - r.left; mouse.y = (e as MouseEvent).clientY - r.top; kick(); }, { passive: true });
      stage.addEventListener('mouseleave', () => { mouse.x = -9999; mouse.y = -9999; });
      resampleBtn?.addEventListener('click', renoise);
    }

    // ── Command palette (singleton; markup persists) ────────────────────────────
    (function cmdk() {
      const root = document.getElementById('cmdk');
      const input = document.getElementById('cmdk-input') as HTMLInputElement | null;
      const list = document.getElementById('cmdk-list');
      const trigger = document.querySelector('.cmdk-trigger');
      if (!root || !input || !list) return;
      if (trigger && /mac/i.test(navigator.platform || navigator.userAgent)) trigger.textContent = '⌘K';
      else if (trigger) trigger.textContent = 'Ctrl K';
      type Cmd = { label: string; hint: string; type: 'nav' | 'ext' | 'mail'; to: string };
      const commands: Cmd[] = [
        { label: 'Home', hint: 'the landing', type: 'nav', to: '/' },
        { label: 'Work', hint: 'projects, experience, research', type: 'nav', to: '/work' },
        { label: 'Story', hint: 'india to singapore to silicon valley', type: 'nav', to: '/story' },
        { label: 'Beyond', hint: 'sport and books', type: 'nav', to: '/beyond' },
        { label: 'Contact', hint: 'email and links', type: 'nav', to: '/contact' },
        { label: 'GitHub', hint: 'github.com/parvpatodia', type: 'ext', to: 'https://github.com/parvpatodia' },
        { label: 'LinkedIn', hint: 'linkedin profile', type: 'ext', to: 'https://www.linkedin.com/in/parvpatodia-ai-silicon-valley' },
        { label: 'Email', hint: 'parvpatodia09@gmail.com', type: 'mail', to: 'mailto:parvpatodia09@gmail.com' },
        { label: 'Resume', hint: 'open the pdf', type: 'ext', to: '/resume.pdf' }
      ];
      let isOpen = false, active = 0, filtered: Cmd[] = commands.slice(), lastFocus: Element | null = null;
      function render() {
        list!.innerHTML = filtered.map((c, i) => `<li role="option" id="cmdk-opt-${i}" aria-selected="${i === active}" class="cmdk-item${i === active ? ' active' : ''}" data-i="${i}"><span class="cmdk-label">${c.label}</span><span class="cmdk-hint">${c.hint}</span></li>`).join('');
        input!.setAttribute('aria-activedescendant', filtered.length ? `cmdk-opt-${active}` : '');
      }
      function doFilter() {
        const s = input!.value.trim().toLowerCase();
        filtered = s ? commands.filter((c) => (c.label + ' ' + c.hint).toLowerCase().includes(s)) : commands.slice();
        active = 0; render();
      }
      function open() {
        if (isOpen) return; isOpen = true; lastFocus = document.activeElement;
        root!.hidden = false; document.documentElement.classList.add('cmdk-open');
        input!.setAttribute('aria-expanded', 'true');
        input!.value = ''; doFilter(); input!.focus(); requestAnimationFrame(() => input!.focus());
      }
      function close() {
        if (!isOpen) return; isOpen = false; root!.hidden = true; document.documentElement.classList.remove('cmdk-open');
        input!.setAttribute('aria-expanded', 'false');
        if (lastFocus instanceof HTMLElement) lastFocus.focus();
      }
      function activate(i: number) {
        const c = filtered[i]; if (!c) return; close();
        if (c.type === 'nav') navigate(c.to);
        else if (c.type === 'mail') location.href = c.to;
        else window.open(c.to, '_blank', 'noopener');
      }
      function move(d: number) {
        if (!filtered.length) return;
        active = (active + d + filtered.length) % filtered.length; render();
        const el = document.getElementById(`cmdk-opt-${active}`); if (el) el.scrollIntoView({ block: 'nearest' });
      }
      input.addEventListener('input', doFilter);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
        else if (e.key === 'Enter') { e.preventDefault(); activate(active); }
        else if (e.key === 'Escape') { e.preventDefault(); close(); }
        else if (e.key === 'Tab') { e.preventDefault(); }
      });
      list.addEventListener('click', (e) => { const li = (e.target as Element).closest('[data-i]'); if (li) activate(Number((li as HTMLElement).dataset.i)); });
      list.addEventListener('mousemove', (e) => { const li = (e.target as Element).closest('[data-i]'); if (li) { const i = Number((li as HTMLElement).dataset.i); if (i !== active) { active = i; render(); } } });
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); isOpen ? close() : open(); }
      });
      document.addEventListener('click', (e) => {
        const t = e.target as Element;
        if (t.closest('[data-cmdk-open]')) { e.preventDefault(); open(); }
        else if (t.closest('[data-cmdk-close]')) { close(); }
      });
    })();

    // ── Lifecycle: per-navigation setup + teardown ──────────────────────────────
    function onPage() {
      document.documentElement.classList.add('js');
      const trig = document.querySelector('.cmdk-trigger');
      if (trig) trig.textContent = /mac/i.test(navigator.platform || navigator.userAgent) ? '⌘K' : 'Ctrl K';
      initReveals();
      bindMagnetic();
      initHero();
    }
    document.addEventListener('astro:page-load', onPage);
    document.addEventListener('astro:before-swap', destroyHero);
  </script>
</body>
</html>
